APP_NAME=Yunchuan Zhihui MVP
APP_ENV=local
DEBUG=true
SCHEMA_VERSION=1.0
API_V1_PREFIX=/api/v1

FRONTEND_ORIGIN=http://localhost:5173

MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_HOST_PORT=13306
MYSQL_DATABASE=yunchuan_zhihui
MYSQL_USER=yunchuan
MYSQL_PASSWORD=yunchuan_dev
DATABASE_URL=mysql+pymysql://yunchuan:yunchuan_dev@mysql:3306/yunchuan_zhihui

CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_PERSIST_DIRECTORY=/app/data/chroma

OPENAI_API_BASE=
OPENAI_API_KEY=
PRIMARY_LLM_MODEL=
PRIMARY_REVIEW_MODEL=
SECONDARY_REVIEW_MODEL=qwen-plus
PRIMARY_REVIEW_FALLBACK_MODEL=
SECONDARY_REVIEW_FALLBACK_MODEL=
EMBEDDING_MODEL=
LLM_TIMEOUT_SECONDS=60
LLM_JSON_SCHEMA_MODE=json_object
GENERATION_MAX_OUTPUT_TOKENS=4000
GRADED_QUIZ_MAX_OUTPUT_TOKENS=6000
REVIEW_MAX_OUTPUT_TOKENS=3000
REVIEW_TIMEOUT_SECONDS=45
REVIEW_TASK_TIMEOUT_SECONDS=150
REVIEW_BATCH_TARGET_INPUT_TOKENS=4200
REVIEW_BATCH_HARD_INPUT_TOKENS=5000
REVIEW_BATCH_OUTPUT_TOKENS=1400
REVIEW_BATCH_MAX_CLAIMS=12
GENERATION_MODEL_CONCURRENCY=3
REVIEW_MODEL_CONCURRENCY=4
ALLOW_FIXTURE_LLM=false
ENABLE_EVALUATION_OVERRIDES=false
ENABLE_EVALUATION_RUNNER=false
ENABLE_KNOWLEDGE_IMPORT_MODELS=true
KNOWLEDGE_IMPORT_MODEL_CONCURRENCY=4
KNOWLEDGE_IMPORT_GENERATION_CONCURRENCY=4
KNOWLEDGE_IMPORT_REVIEW_CONCURRENCY=3
KNOWLEDGE_IMPORT_BATCH_TARGET_TOKENS=8000

LOG_LEVEL=INFO
ENABLE_FULL_DEBUG_PAYLOADS=false
REDIS_URL=redis://redis:6379/0
JWT_SECRET_KEY=replace-with-a-long-random-secret
COOKIE_SECURE=false
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=change-me-before-first-run
INITIAL_ADMIN_DISPLAY_NAME=系统管理员
